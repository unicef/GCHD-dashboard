# API keys for the infrastructure fetch scripts.
# Copy this file to scripts/.env and fill in the values you have:
#     cp scripts/.env.example scripts/.env
#
# scripts/ is already git-ignored, so .env will not be committed.
# Any key left blank simply means that source is skipped.

# Giga school locations (fetch_giga_schools.py)
# Request access at https://maps.giga.global/ (UNICEF Giga).
GIGA_SCHOOL_LOCATION_API_KEY=

# healthsites.io (fetch_healthsites.py)
# Sign in at https://healthsites.io with an OpenStreetMap account,
# then copy the token from your profile page.
HEALTHSITES_API_KEY=

# WPdx+ water points (fetch_wpdx_water.py) — OPTIONAL.
# Works anonymously; a Socrata app token only raises the rate limit.
# Get one at https://data.waterpointdata.org/profile/edit/developer_settings
WPDX_APP_TOKEN=

# mWater needs no key — its public v3 API is readable anonymously.
